# === Connectivity/Hosting ===

NAME='Chain Isles'

HOST='localhost'
PORT=9001

# Use HTTPS
SSL=false

# API Configuration
API_ENABLED=false
API_PORT=9002

# Server ID (increment with each server hosted)
SERVER_ID=1
ACCESS_TOKEN=''

# Hub Configuration
HUB_ENABLED=false
# Defaults to `HOST` if empty
HUB_HOST=''
HUB_WS_HOST=''
HUB_PORT=9526
HUB_WS_PORT=9527
# The host sent to the hub, if empty string, hub will try to find the IP.
# Not recommended to have as empty string for production environments.
REMOTE_SERVER_HOST=''
# Remote API host, if empty string, hub will use `REMOTE_SERVER_HOST`
REMOTE_API_HOST=''
# Make sure it matches with the hub.
# Note that if you take the hub-server approach, you should NEVER
# rely solely on `HUB_ACCESS_TOKEN`. This is just a minimal safety feature.
# Instead, please look into properly setting up the firewall such that
# connections are limited to only trusted clients and APIs.
HUB_ACCESS_TOKEN=''

# Defaults to `HUB_HOST` if empty
ADMIN_HOST=''
ADMIN_PORT=9528

# Overrides where the client connects to
# Defaults to `HOST` for the client if empty
CLIENT_REMOTE_HOST=''
# Defaults to `PORT` for the client if empty
CLIENT_REMOTE_PORT=

# Server List Configs
CLEANUP_THRESHOLD=120000
CLEANUP_TIME=30000

# === Database ===

# Skip database checking upon login
SKIP_DATABASE=true

# Used for multiple database support
DATABASE='mongodb'

MONGODB_HOST='127.0.0.1'
MONGODB_PORT=27017
MONGODB_USER=''
MONGODB_PASSWORD=''
MONGODB_DATABASE='chainisles'
MONGODB_TLS=false
# Use the `mongodb+srv` syntax
MONGODB_SRV=false
# If you need to authenticate against a different database
MONGODB_AUTH_SOURCE=''
# When we're allowed to aggregate new data.
AGGREGATE_THRESHOLD=60000

# === World Configurations ===

# Players have to finish the tutorial before proceeding.
TUTORIAL_ENABLED=true
# !! Allows login with any credentials !!
OVERWRITE_AUTH=false
DISABLE_REGISTER=false
# Maximum number of players allowed on the server.
MAX_PLAYERS=200
# Update time to parse packets in milliseconds (update every 300ms)
UPDATE_TIME=300
# Game version
GVER='0.5.5-beta'
# Used for hotfixes and minor updates that do not require a full update.
MINOR=''
# If to load regions from cache.
REGION_CACHE=true
# How often to save the world.
SAVE_INTERVAL=60000
# How many messages per second are allowed
MESSAGE_LIMIT=300

# === SMTP ===
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=465
SMTP_USE_SECURE=true
# This is the email that will be used to send emails.
SMTP_USER=''
# An app password can be generated from the Google account settings.
SMTP_PASSWORD=''

# === Sentry ===
SENTRY_ORG=''
SENTRY_PROJECT=''
SENTRY_AUTH_TOKEN=''
SENTRY_DSN=''

# === Stripe ===
STRIPE_ENDPOINT=''
STRIPE_KEY_LOCAL=''
STRIPE_SECRET_KEY=''

# === Discord ===

# If to connect to Discord or not.
DISCORD_ENABLED=false
# The discord channel ID we are monitoring messages of
DISCORD_CHANNEL_ID=``
# The bot token used to interact with the server.
DISCORD_BOT_TOKEN=''

# === LICENSING ===
# By using this project, you agree to the terms and conditions outlined in the MPL2.0 and OPL license.
# These licenses can be found in the LICENSE and LICENSE_OPL files respectively.
# Toggling the following indicates that you have read and agree to all the terms and conditions outlined in the licenses.
# Any form of bypassing/altering of the license agreement form indicates you agree to the terms and conditions outlined in the licenses.
ACCEPT_LICENSE=false

# === Solana / On-chain ===
# Cluster: localnet | devnet | mainnet-beta
SOLANA_CLUSTER=mainnet-beta
# Deploy `program/chainmmo` and paste your program id here after `anchor deploy`
SOLANA_PROGRAM_ID=BkP5QCG2x67bqXkngUFRBUzoGx5fNZzW5vY2nHZydjFv
# Wallet that receives the 5% marketplace fee
SOLANA_TREASURY=5E1aC5fUKckpfrks1GkgEwNmspcSWX6pjWz1VJeCDq6n
# Game server keypair for attested gold sync (path relative to packages/server)
GAME_AUTHORITY_KEYPAIR=../../keys/game-authority.json
GAME_AUTHORITY_PUBLIC_KEY=GTYkSZA9BzAo8mEX98dx61fPUaauoD6L3ERtS2Go9PqV

# === MongoDB (Atlas) — set SKIP_DATABASE=false when configured ===
# MONGODB_SRV=true
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_DATABASE=chainisles
# MONGODB_TLS=true
# MONGODB_AUTH_SOURCE=admin

# === Token / contract (login screen) ===
# TOKEN_GATE_ENABLED=false at launch — guest & account login open to everyone.
# TOKEN_GATE_MINT is still shown on the login screen as the coin contract address.
TOKEN_GATE_ENABLED=false
# SPL token mint (pump.fun CA) — displayed on login; gating optional later
TOKEN_GATE_MINT=4TNkgR5vyn9bcYzfGAGMpdYjnxkwFAZysgHe254zpump
# Minimum balance in smallest token units (e.g. 1 = 1 token if decimals=0)
TOKEN_GATE_MIN_AMOUNT=1
# Display symbol on the login screen
TOKEN_GATE_SYMBOL=ISLE
# Token decimals for display formatting (pump.fun SPL tokens use 6)
TOKEN_GATE_DECIMALS=6

# === Marketplace stimulus (buyer rebate + ISLE tiers) ===
# Fund rebates from treasury/creator wallet SOL → in-game gold is minted via server on purchase.
STIMULUS_ENABLED=true
# Base buyer rebate in basis points (500 = 5% bonus gold on every gold-market buy)
STIMULUS_BUYER_REBATE_BPS=500
# Minimum gold purchased to qualify
STIMULUS_MIN_GOLD_PURCHASE=1000
# Max bonus gold paid to one wallet per UTC day
STIMULUS_MAX_REBATE_GOLD_PER_DAY=100000
# If true, buyer must hold ISLE at bronze tier or higher
STIMULUS_REQUIRE_ISLE_HOLD=false
# ISLE tiers (human-readable token amounts; uses TOKEN_GATE_DECIMALS)
STIMULUS_ISLE_TIER_BRONZE=10000
STIMULUS_ISLE_TIER_SILVER=100000
STIMULUS_ISLE_TIER_GOLD=1000000
# Extra rebate per tier, basis points (200 = +2%)
STIMULUS_ISLE_BRONZE_BONUS_BPS=200
STIMULUS_ISLE_SILVER_BONUS_BPS=500
STIMULUS_ISLE_GOLD_BONUS_BPS=1000
# Item category bounties: packages/server/data/stimulus-bounties.json

# === Debugging ===

# Will print out more debugging info from log
DEBUGGING=false
DEBUG_LEVEL='all'
# filestream debugging -> Write to a filestream instead of stdout.
FS_DEBUGGING=false
