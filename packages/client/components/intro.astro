---
import { t, getLanguage } from '@kaetram/common/i18n';
import config from '@kaetram/common/config';

let tokenMint = (config.tokenGateMint || '').trim(),
    tokenSymbol = config.tokenGateSymbol || 'TOKEN',

 currentLanguage = getLanguage(),
    languages = [
        { locale: 'en', name: 'English' },
        { locale: 'de', name: 'Deutsch' },
        { locale: 'es', name: 'Español' },
        { locale: 'fr', name: 'Français' },
        { locale: 'pt', name: 'Português' },
        { locale: 'ro', name: 'Română' },
        { locale: 'ru', name: 'Русский' },
        { locale: 'tl', name: 'Tagalog'}
    ];
---

<div id="intro">
    <section id="parchment" class="load-character slice-menu-fancy">
        <article id="load-character">
            <h1 class="title-decoration">{t('game:NAME')}</h1>
            <p id="online-count" class="online-count">Players online: —</p>

            <form onsubmit={'return false'}>
                <button
                    type="button"
                    id="play-as-guest"
                    class="stroke slice-button-green guest-primary"
                    title="Play as a guest"
                    aria-label="Play as a guest"
                >
                    PLAY AS GUEST
                </button>

                <p class="login-divider">— or sign in with an account —</p>

                <div id="legacy-login">
                <input
                    type="text"
                    id="login-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder="Username"
                    aria-label="Username"
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="login-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder="Password"
                    aria-label="Password"
                    maxlength="64"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row login-options">
                    <label id="remember-me" class="check">
                        <input type="checkbox" aria-labelledby="remember-me-text" />
                        <span class="checkmark"></span>

                        <span id="remember-me-text">Remember Me</span>
                    </label>
                </div>

                <div class="button-row">
                    <button
                        title="Login"
                        aria-label="Login"
                        type="submit"
                        id="login"
                        class="stroke slice-button"
                        disabled
                    >
                        LOGIN
                    </button>
                    <button
                        title="New Account"
                        aria-label="New Account"
                        type="button"
                        id="new-account"
                        class="stroke slice-button"
                    >
                        NEW ACCOUNT
                    </button>
                </div>
                </div>

                {/* Hidden — toggled by the Play as Guest button */}
                <label id="guest" class="check guest-hidden" hidden>
                    <input type="checkbox" aria-labelledby="guest-text" />
                    <span id="guest-text">Play as a guest</span>
                </label>

                <div id="wallet-connect" class="wallet-panel">
                    <div class="wallet-actions">
                        <button
                            type="button"
                            id="connect-wallet"
                            class="stroke slice-button wallet-button"
                            title="Connect Phantom Wallet"
                            aria-label="Connect Phantom Wallet"
                        >
                            CONNECT WALLET
                        </button>
                        <button
                            type="button"
                            id="login-with-wallet"
                            class="stroke slice-button wallet-button"
                            title="Sign in with Phantom Wallet"
                            aria-label="Sign in with Phantom Wallet"
                        >
                            PLAY WITH WALLET
                        </button>
                    </div>
                    <span id="wallet-address" class="wallet-address" hidden></span>
                    <p id="token-gate-notice" class="wallet-status token-gate-notice" hidden></p>
                    <p id="wallet-status" class="wallet-status"></p>
                </div>
            </form>
        </article>

        <article id="create-character">
            <h1 class="title-decoration">New Character</h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="register-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder="Username"
                    aria-label="Username"
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder="Password"
                    aria-label="Password"
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-confirmation-input"
                    class="stroke slice-input"
                    name="player-password2"
                    placeholder="Confirm Password"
                    aria-label="Confirm Password"
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="email"
                    id="register-email-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder="Email Address"
                    aria-label="Email Address"
                    maxlength="64"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title="Cancel"
                        aria-label="Cancel"
                        type="button"
                        id="cancel-register"
                        class="stroke slice-button"
                    >
                        CANCEL
                    </button>
                    <button
                        title="Play"
                        aria-label="Play"
                        type="submit"
                        id="play"
                        class="stroke slice-button"
                    >
                        PLAY
                    </button>
                </div>
            </form>
        </article>

        <article id="reset-password">
            <h1>
                <span class="left-ornament"></span>
                 Reset Password
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="email-reset-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder="Email Address"
                    aria-label="Email Address"
                    maxlength="32"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title="Cancel"
                        aria-label="Cancel"
                        type="button"
                        id="cancel-forget"
                        class="stroke slice-button"
                    >
                        CANCEL
                    </button>
                    <button
                        title="Submit"
                        aria-label="Submit"
                        type="submit"
                        id="continue-forget"
                        class="stroke slice-button"
                    >
                        CONTINUE
                    </button>
                </div>
            </form>
        </article>

        <article id="world-select">
            <h1>
                <span class="left-ornament"></span>
                 World Select
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <ol id="worlds"></ol>

                <div class="button-row">
                    <button
                        title="Cancel"
                        aria-label="Cancel"
                        type="button"
                        id="cancel-worlds"
                        class="stroke slice-button"
                    >
                        CANCEL
                    </button>
                    <button
                        title="Continue"
                        aria-label="Continue"
                        type="submit"
                        id="continue-worlds"
                        class="stroke slice-button"
                    >
                        CONTINUE
                    </button>
                </div>
            </form>
        </article>

        <article id="credits">
            <h1 class="title-decoration">Credits</h1>

            <p>
                <br />
                 Special thanks to
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.littleworkshop.fr/">Little Workshop</a
                >
                 for the pixel art,
                <br />
                <br />
                 and the Asky Team.
                <br />
                <br />
                 More pixel assets by
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/users/buch">Buch</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://shikashiassets.itch.io/shikashis-fantasy-icons-pack">Shikashi</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/content/kyrises-free-16x16-rpg-icon-pack"
                    >Kyrise</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://game-icons.net">Game-Icons.net</a
                >, &amp; Boo
                <br />
                <br />
                 Music by
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://soundcloud.com/gyrowolf">Terrel O'Brien</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://blog.dayjo.org">Joel Day</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.dantilden.com">Dan Tilden</a
                >, &amp;
                <a
                    rel="noopener noreferrer"
                    target="_blank"
                    class="clickable"
                    href="https://soundcloud.com/aaron-anderson-11">Aaron Krogh</a
                >
            </p>

            <div class="close-about">
                <span>-- Click anywhere to close --</span>
            </div>
        </article>

        <article id="about">
            <h1 class="title-decoration">About</h1>

            <p>
                Chain Isles is a Kaetram Solana fork — a browser-based 2D MMORPG. Explore the
                archipelago, level your skills, fight monsters, trade with other players, and
                connect a wallet to use the on-chain gold marketplace.
            </p>

            <div class="close-about">
                <span>-- Click anywhere to close --</span>
            </div>
        </article>

        <article id="git">Structure this later</article>

        <article id="death">
            <h1>You have died...</h1>
            <button
                title="Respawn"
                id="respawn"
                title="Respawn"
                aria-label="Respawn"
                class="stroke slice-button">RESPAWN</button
            >
        </article>

        <span class="loader" hidden>
            Connecting<span class="loader-dot">.</span><span class="loader-dot">.</span><span
                class="loader-dot">.</span
            >
        </span>
    </section>

    <div id="intro-topbar" class="intro-topbar">
        {
            tokenMint && (
                <div id="token-ca" class="token-ca">
                    <span class="token-ca-label">{tokenSymbol} contract</span>
                    <code id="token-ca-address" class="token-ca-address" title={tokenMint}>
                        {tokenMint}
                    </code>
                    <div class="token-ca-actions">
                        <button
                            type="button"
                            id="copy-token-ca"
                            class="stroke slice-button token-ca-copy"
                            title="Copy contract address"
                            aria-label="Copy contract address"
                        >
                            COPY CA
                        </button>
                        <a
                            class="token-ca-link clickable stroke slice-button"
                            href={`https://solscan.io/token/${tokenMint}`}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            SOLSCAN
                        </a>
                    </div>
                </div>
            )
        }

        <select id="lang-select" oninput={'location = "/" + this.value + "/"'}>
            {
                languages.map(({ locale, name }) => (
                    <option value={locale} selected={locale === currentLanguage}>
                        {name}
                    </option>
                ))
            }
        </select>
    </div>

    <button id="world-select-button" class="slice-button" hidden>
        <strong class="stroke"></strong>
        <span class="stroke"></span>
    </button>

    <span id="game-version" class="version"></span>

    <footer>
        <div id="about-link" class="clickable">
            <span id="toggle-about">About</span>
        </div>
        <span>&ndash;</span>
        <div id="credits-link" class="clickable">
            <span id="toggle-credits">Credits</span>
        </div>
        <span>&ndash;</span>
        <div id="privacy" class="clickable">
            <a class="footer-button" href="/privacy/">
                <span>Privacy</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div id="reset" class="clickable">
            <span id="toggle-reset-password">Reset Password</span>
        </div>
    </footer>
</div>
